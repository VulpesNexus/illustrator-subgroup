// The About dialog, kept in a file of its own so the plug-in's resource script
// and tools/AboutHarness can compile the same template. If they diverged, the
// harness would stop being evidence about the shipped dialog.
//
// Every string is set from SubgroupAbout.cpp rather than written here. The
// prose is RTF, and the rest contains an em dash and a copyright sign, while a
// resource script is compiled in a single-byte code page. Keeping the text on
// the C++ side lets it be UTF-16 with those characters written as escapes,
// which no encoding can misread.
//
// Sizes are in dialog units, so the layout follows the user's shell font and
// DPI rather than a pixel guess. The white panel ends at kAboutSplitDlgY; the
// dialog procedure paints the two bands and the rule between them.

IDD_SUBGROUP_ABOUT DIALOGEX 0, 0, 284, 226
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Subgroup"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    // On the white panel.
    CONTROL         "", IDC_ABOUT_TITLE, "SysLink", WS_TABSTOP, 16, 12, 252, 20

    // The prose. RICHEDIT50W is registered by loading Msftedit.dll, which
    // SubgroupShowAboutDialog does before creating the dialog. No WS_TABSTOP
    // and no border: it is a paragraph of text, not a field.
    CONTROL         "", IDC_ABOUT_BODY, "RICHEDIT50W",
                    ES_MULTILINE | ES_READONLY | WS_CHILD | WS_VISIBLE,
                    16, 40, 252, 110

    // On the button band, below kAboutSplitDlgY.
    DEFPUSHBUTTON   "OK", IDOK, 216, 166, 52, 15
    CONTROL         "", IDC_ABOUT_LEGAL, "SysLink", WS_TABSTOP, 16, 190, 252, 30
END
