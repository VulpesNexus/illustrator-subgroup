# core.autocrlf is commonly on for Windows checkouts. Say explicitly what is
# text and what is not, so a clone can never line-ending-mangle the shipped
# binary — that failure is silent and produces a plug-in Illustrator refuses
# to load.

*               text=auto

*.aip           binary
*.pipl          binary

# Visual Studio writes these CRLF and rewrites them if it finds otherwise.
*.vcxproj       text eol=crlf
*.vcxproj.*     text eol=crlf
*.props         text eol=crlf
*.rc            text eol=crlf

*.h             text
*.cpp           text
*.jsx           text
*.jsxinc        text
*.md            text
